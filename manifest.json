{
  "manifest_version": 3,
  "name": "IITB Webmail+",
  "version": "1.0.1",
  "description": "A sleeker IITB webmail: instant search, your courses, a deadline calendar, files finder, muted lists and shortcuts.",
  "content_scripts": [
    {
      "matches": [
        "https://webmail.iitb.ac.in/*"
      ],
      "js": [
        "early.js"
      ],
      "css": [
        "theme.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://webmail.iitb.ac.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/pranav-jaju/iitb-webmail-plus"
}
